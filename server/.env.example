PORT=5000
MONGODB_URI=mongodb://localhost:27017/smart-classroom
JWT_SECRET=your_jwt_secret_change_me_in_prod
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
OTP_EXPIRY_SECONDS=60
MAX_FILE_SIZE_MB=10
# Demonstration Mode (Set to true to run in-memory without MongoDB Atlas)
# Leave false or omitted for standard MongoDB Atlas mode
DEMO_MODE=false
